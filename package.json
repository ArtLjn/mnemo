  "description": "Structured fact memory MCP server — SQLite + FTS5, trust scoring, entity graph, bilingual retrieval for Claude Code & Codex",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mnemo": "dist/server.js",
    "mnemo-init": "dist/init.js",
    "mnemo-dream": "dist/dream.js"
  },
  "publishConfig": {
